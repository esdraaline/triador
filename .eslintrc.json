{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "globals": {
    "GmailApp": "readonly",
    "SpreadsheetApp": "readonly",
    "UrlFetchApp": "readonly",
    "PropertiesService": "readonly",
    "ScriptApp": "readonly",
    "Logger": "readonly",
    "Utilities": "readonly"
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "env": {
        "jest": true
      }
    }
  ]
}
